rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════════════
    // Helper Functions
    // ═══════════════════════════════════════════════════════════════════

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      // Role stored on the user's Firestore document, set manually or via
      // a Cloud Function. Never trust a client-supplied role claim.
      return isSignedIn() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function validProductWrite() {
      // Enforce the schema on every product write
      let d = request.resource.data;
      return d.keys().hasAll(["name", "price", "category", "stock", "imageUrl"])
        && d.name is string && d.name.size() > 0
        && d.price is number && d.price >= 0
        && d.stock is int && d.stock >= 0;
    }

    function validOrderWrite(uid) {
      let d = request.resource.data;
      return isOwner(uid)
        && d.uid == uid
        && d.items is list && d.items.size() > 0
        && d.total is number && d.total >= 0
        && d.status == "pending";  // clients can only create pending orders
    }

    // ═══════════════════════════════════════════════════════════════════
    // /users/{uid}
    // ═══════════════════════════════════════════════════════════════════

    match /users/{uid} {
      // Users can read & update their own document; admins can read all
      allow read:   if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid)
                    && !request.resource.data.diff(resource.data).affectedKeys()
                       .hasAny(["role", "uid", "createdAt"]); // immutable fields
      allow delete: if isAdmin();

      // ── /users/{uid}/orders/{orderId} ───────────────────────────────

      match /orders/{orderId} {
        allow read:   if isOwner(uid) || isAdmin();
        allow create: if validOrderWrite(uid);

        // Order updates (status changes) only by admins (or Cloud Functions)
        allow update: if isAdmin();
        allow delete: if false; // orders are never deleted
      }
    }

    // ═══════════════════════════════════════════════════════════════════
    // /products/{productId}
    // ═══════════════════════════════════════════════════════════════════

    match /products/{productId} {
      // Anyone (even unauthenticated) can browse products
      allow read: if true;

      // Only admins may create, update, or delete products
      allow create: if isAdmin() && validProductWrite();
      allow update: if isAdmin() && validProductWrite();
      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════
    // /categories/{categoryId}  (read-only reference data)
    // ═══════════════════════════════════════════════════════════════════

    match /categories/{categoryId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════
    // Default deny-all (safety net)
    // ═══════════════════════════════════════════════════════════════════

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
